{
  "name": "pancake-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "dev:fixtures-ui": "node tests/run-fixture-ui.mjs",
    "build": "tsc",
    "start": "node dist/server.js",
    "backup": "node scripts/backup.mjs",
    "restore": "node scripts/restore.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.mjs",
    "test:integration": "node --test tests/backend-fixes.integration.test.mjs",
    "test:migrations": "node --test tests/migrations.integration.test.mjs"
  },
  "dependencies": {
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
