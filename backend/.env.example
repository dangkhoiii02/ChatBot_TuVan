PORT=4000
NODE_ENV=development

PANCAKE_BASE_URL=https://pages.fm/api
PANCAKE_PAGE_ID=
PANCAKE_PAGE_ACCESS_TOKEN=

# App session JWT for staff APIs after POST /api/auth/login
APP_SESSION_SECRET=change-me
APP_SESSION_TTL_SECONDS=43200

# Optional CSV allowlist — OFF by default. Enable only for emergency/dev fallback.
PANCAKE_ACTIVE_USER_IDS=
ENABLE_ENV_ACTIVE_USER_FALLBACK=0
# When 1, also accept phase-1 header X-User-Id against PANCAKE_ACTIVE_USER_IDS
ALLOW_DEV_USER_HEADER=0

PANCAKE_CONVERSATION_LIMIT=30
PANCAKE_MESSAGE_LIMIT=30

AI_PROVIDER=auto
AI_API_KEY=
AI_MODEL=
AI_BASE_URL=
# Exact HTTPS base URLs authorized for custom providers (comma separated)
AI_ALLOWED_BASE_URLS=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
GEMINI_MODEL=
AI_KNOWLEDGE_DIR=../data

DEMO_REPLY_STORE_PATH=./data/demo_replies.jsonl

# Optional extra browser origins (comma-separated) for CORS
CORS_ORIGINS=
