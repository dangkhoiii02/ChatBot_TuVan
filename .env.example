# Cấu hình mạng máy chủ (mặc định loopback an toàn)
HOST=127.0.0.1
PORT=3000

# Đường dẫn lưu trữ SQLite Database (nằm ngoài thư mục public)
DATABASE_PATH=storage/app.db

# Cấu hình Provider AI (gemini hoặc mock)
PROVIDER=mock
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Giới hạn hàng đợi và xử lý song song
CONCURRENCY_LIMIT=3
QUEUE_LIMIT=50
CALL_TIMEOUT_MS=30000
MAX_JOB_DEADLINE_MS=120000
MAX_RETRY_ATTEMPTS=2

# Giới hạn bảo mật & Nguồn gốc web cho phép (phân tách bởi dấu phẩy, để trống nếu chỉ cùng origin)
ALLOWED_ORIGINS=http://127.0.0.1:3000,http://localhost:3000
MAX_REQUEST_BODY_BYTES=1048576

# Cấu hình thời gian lưu trữ (TTL) dữ liệu
JOB_RETENTION_DAYS=7
FEEDBACK_RETENTION_DAYS=90
